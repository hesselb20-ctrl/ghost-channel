{
  "name": "ghost-channel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Invisible screen-to-camera data channel that runs entirely in the browser",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sim:model": "node src/sim/run-model.ts",
    "sim:sweep": "node src/sim/run-sweep.ts",
    "sim:join": "node src/sim/run-join.ts",
    "sim:codec": "node src/sim/run-codec.ts"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@types/node": "^26.6.6"
  }
}
